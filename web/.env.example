# Copy this file to web/.env.local and fill in the values from:
# Firebase console → Project settings (gear) → General → Your apps → Web app → "SDK setup and configuration" → Config.
# These are NOT secrets (every Firebase web app ships them to the browser); security comes from firestore.rules.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=
