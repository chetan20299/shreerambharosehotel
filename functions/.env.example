# Functions configuration.
#
# BOOTSTRAP_TOKEN is a SECRET (Secret Manager), not an env var. Set it once in production:
#   npx firebase functions:secrets:set BOOTSTRAP_TOKEN      (use a random value of 32+ characters)
# For local emulators it is read from functions/.secret.local:
#   BOOTSTRAP_TOKEN=local-emulator-bootstrap-token-0123456789
#
# DEMO_MODE enables the "Demo as Admin / Waiter" buttons. It only takes effect when the project id starts
# with "demo-" (emulator), so it can never be enabled in production. It lives in functions/.env.demo-srbh.
# DEMO_MODE=true
